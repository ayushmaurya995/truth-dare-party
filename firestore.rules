rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      // A player must know the room code to read a room and join it.
      // Listing all rooms is never allowed.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.players.size() == 1;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() <= 12
        && request.resource.data.players.size() <= 12;

      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
